{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["./*"]
        },
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "noEmit": true,
        "incremental": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "plugins": [
            {
                "name": "next"
            }
        ],
        "module": "esnext"
    },
    "include": [
        "next-env.d.ts",
        "**/*.js",
        "**/*.jsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "**/*.mts",
        "**/*.ts",
        "**/*.tsx"
    ],
    "exclude": ["node_modules"]
}

